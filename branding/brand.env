# Configurare branding — editează valorile de mai jos, apoi rulează:
#   python3 branding/apply.py
# (sau lasă workflow-ul GitHub "Apply branding" să o facă automat la push).

# Numele tehnic al aplicației (în aplicație, foldere, servicii). Doar litere și cifre, fără spații,
# 2-31 caractere, să înceapă cu literă. NU poate fi "RustDesk".
APP_NAME=RDNRemote

# Numele afișat de sistem (scurtături, meniul Start, ecranul telefonului, proprietățile
# fișierului). Poate conține spații. Dacă îl lași gol, se folosește APP_NAME.
DISPLAY_NAME=RDN Remote

# Adresa serverului tău (hbbs): domeniu sau IP, opțional cu port (implicit 21116).
# Exemplu: remote.firma-mea.ro
RENDEZVOUS_SERVER=remote.rdndata.ro

# Cheia publică a serverului: conținutul fișierului server/data/id_ed25519.pub
# (44 de caractere, se termină de obicei cu "="). O primești după ce pornești serverul.
RS_PUB_KEY=CHANGE_ME

# Firma care publică aplicația (apare ca „Publisher/Company” și în copyright).
COMPANY=RDN Network Data
COPYRIGHT_YEAR=2026

# Linkuri din ecranul „Despre” al aplicației. PRIVACY_URL implicit = WEBSITE_URL.
WEBSITE_URL=https://remote.rdndata.ro
PRIVACY_URL=https://remote.rdndata.ro/confidentialitate.html
# Obligatoriu (licența AGPL-3.0): unde găsesc utilizatorii codul sursă.
SOURCE_URL=https://github.com/danielneagu2000/Rust-Desktop

# Identificatorul aplicației pe Android (diferit de RustDesk, ca să se poată instala alături).
# ATENȚIE: nu-l mai schimba după prima distribuire; altfel telefoanele o văd ca altă aplicație.
ANDROID_APP_ID=ro.rdndata.remote

# Licență obligatorie (Y/N): fără un cod de licență valid, emis din panoul de securitate,
# aplicația nu se poate conecta și nu poate fi accesată.
LICENSE_REQUIRED=Y

# Actualizare automată implicită pe Windows și macOS (Y/N). Utilizatorul o poate opri din setări.
AUTO_UPDATE=Y

# Contact afișat în pachetele Linux și în textul de licență al instalatorului MSI.
SUPPORT_EMAIL=office@rdndata.ro
SUPPORT_PHONE=0723 122 097

# Opțional: adresa la care clienții trimit jurnalele pentru panoul de securitate.
# Lasă gol: se folosește automat http://RENDEZVOUS_SERVER:21114 (panoul din server/).
API_SERVER=

# Culoarea de fundal a iconiței adaptive pe Android (format #RRGGBB).
ANDROID_ICON_BACKGROUND=#ffffff
